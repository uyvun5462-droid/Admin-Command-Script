    local character = player.Character or player.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart")
    local humanoid = character:WaitForChild("Humanoid")
    humanoid.PlatformStand = true
    bv = Instance.new("BodyVelocity") bv.MaxForce = Vector3.new(1e6, 1e6, 1e6) bv.Velocity = Vector3.zero bv.Parent = rootPart
    bg = Instance.new("BodyGyro") bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6) bg.P = 10000 bg.CFrame = rootPart.CFrame bg.Parent = rootPart
    flyConnection = RunService.RenderStepped:Connect(function()
        if not flying or not rootPart or not humanoid or humanoid.Health <= 0 then stopFly() return end
        bg.CFrame = camera.CFrame
        local moveDir = humanoid.MoveDirection local verticalDir = 0 local verticalSpeed = flySpeed * 1.5
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) or isPressingUp then verticalDir = verticalDir + 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or isPressingDown then verticalDir = verticalDir - 1 end
        bv.Velocity = (moveDir * flySpeed) + Vector3.new(0, verticalDir * verticalSpeed, 0)
    end)
end

local viewingPlayer = nil
local function unviewPlayer()
    if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
        camera.CameraSubject = player.Character:FindFirstChildOfClass("Humanoid")
    end
    viewingPlayer = nil
end

local function viewPlayer(targetName)
    if not targetName or targetName == "" then unviewPlayer() return end
    local targetPlayer = nil
    for _, p in ipairs(Players:GetPlayers()) do
        if string.sub(string.lower(p.Name), 1, #targetName) == string.lower(targetName) or string.sub(string.lower(p.DisplayName), 1, #targetName) == string.lower(targetName) then
            targetPlayer = p break
        end
    end
    if targetPlayer and targetPlayer.Character then
        local humanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then camera.CameraSubject = humanoid viewingPlayer = targetPlayer else showNotification("No Humanoid") end
    else showNotification("Player Not Found") end
end

